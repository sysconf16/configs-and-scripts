<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <userSettings>
        <Universal_x86_Tuning_Utility.Properties.Settings>
            <setting name="StartOnBoot" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="StartMini" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="CommandString" serializeAs="String">
                <value>--UXTUSR=False-False-0.05-0-False --Win-Power=1 --tctl-temp=75 --cHTC-temp=75 --stapm-limit=18000  --fast-limit=18000 --stapm-time=256 --slow-limit=18000 --slow-time=256 --power-saving </value>
            </setting>
            <setting name="AutoReapplyTime" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="acCommandString" serializeAs="String">
                <value>--UXTUSR=False-False-0.05-0-False --Win-Power=1 --tctl-temp=75 --cHTC-temp=75 --stapm-limit=18000  --fast-limit=18000 --stapm-time=256 --slow-limit=18000 --slow-time=256 --power-saving </value>
            </setting>
            <setting name="dcCommandString" serializeAs="String">
                <value>--UXTUSR=False-False-0.05-0-False --Win-Power=0 --tctl-temp=75 --cHTC-temp=75 --stapm-limit=12000  --fast-limit=12000 --stapm-time=256 --slow-limit=12000 --slow-time=256 --power-saving </value>
            </setting>
            <setting name="acPreset" serializeAs="String">
                <value>AC</value>
            </setting>
            <setting name="dcPreset" serializeAs="String">
                <value>Battery</value>
            </setting>
            <setting name="ApplyOnStart" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="FirstBoot" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Path" serializeAs="String">
                <value>C:\Program Files\JamesCJ60\Universal x86 Tuning Utility\</value>
            </setting>
            <setting name="SettingsUpgradeRequired" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="UpdateCheck" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="isASUS" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="AdapterIdx" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="VSync" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="AutoRestore" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ResMode" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="isMagpie" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Sharpness" serializeAs="String">
                <value>0.05</value>
            </setting>
            <setting name="MinimizeClose" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="cstmPreset" serializeAs="String">
                <value>Battery</value>
            </setting>
            <setting name="DiagnosticLogLevel" serializeAs="String">
                <value>1</value>
            </setting>
        </Universal_x86_Tuning_Utility.Properties.Settings>
    </userSettings>
</configuration>